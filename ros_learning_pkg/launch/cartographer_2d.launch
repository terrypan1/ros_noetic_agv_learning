<launch>

  <!-- Cartographer Node：訂閱 /scan、/odom 與 TF，發布 map -> odom 與 Submap -->
  <node pkg="cartographer_ros"
        type="cartographer_node"
        name="cartographer_node"
        args="-configuration_directory $(find ros_learning_pkg)/config
              -configuration_basename cartographer_2d.lua"
        output="screen">
    <!-- 只有 Cartographer 改收過濾後的 /odom_filtered，原本的 /odom 不改名、不刪除 -->
    <remap from="odom" to="/odom_filtered"/>
  </node>

  <!-- Occupancy Grid Node：把 Submap 合成 nav_msgs/OccupancyGrid，發布到 /map -->
  <node pkg="cartographer_ros"
        type="cartographer_occupancy_grid_node"
        name="cartographer_occupancy_grid_node"
        args="-resolution 0.05"/>

</launch>